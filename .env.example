# Your Tailscale login. Only this account can open the dashboard.
OWNER_LOGIN=you@example.com

# Shared secret the bots use. Generate one with: openssl rand -hex 24
BOT_TOKEN=

# Time zone for "today", the agenda and to-do dates.
TZ=Europe/Rome

# Optional: a Todoist API token (Settings > Integrations > Developer).
# Without it, to-dos come from your bots instead.
TODOIST_TOKEN=

# Optional: show only tasks matching a Todoist filter, like "today | overdue | p1".
# TODOIST_FILTER=

# Optional: PoliTO course avvisi, school messages and deadlines, read through areadidattica
# (https://github.com/SuperTost100/areadidattica-cli). The token is API_TOKEN from its .env.
# With Docker, also set COMPOSE_FILE so the dashboard joins areadidattica's network.
# AREADIDATTICA_URL=http://areadidattica:8789
# AREADIDATTICA_TOKEN=
# COMPOSE_FILE=compose.yaml:compose.polito.yaml
# AREADIDATTICA_NETWORK=areadidattica_default   areadidattica's folder name + _default

# Optional: read WhatsApp, mail and calendars directly. All of these can also be set on the
# Settings page instead. See docs/sources.md.
# WAHA_API_KEY=            a random secret, like: openssl rand -hex 24
# COMPOSE_FILE=compose.yaml:compose.whatsapp.yaml   add :compose.whatsapp2.yaml for a second number, :compose.polito.yaml for PoliTO
# MAIL1_NAME=Gmail
# MAIL1_HOST=imap.gmail.com
# MAIL1_USER=you@gmail.com
# MAIL1_PASSWORD=          for Gmail, an app password
# MAIL2_... and MAIL3_... work the same way
# CALENDAR_URLS=           secret iCal addresses, separated by spaces

# Optional tweaks
# PORT=8787            host port, on 127.0.0.1 only
# UNDO_SECONDS=5       0 to 60
# ARCHIVE_DAYS=30      1 to 365
# BACKUP_DAYS=7        daily backups kept in data/backups, 0 turns them off
# WEBHOOK_ALLOW_PRIVATE=0   1 lets bots register webhooks on your LAN or tailnet

# Docker only: the user and group that own ./data (check with: id -u, id -g)
# DASHBOARD_UID=1000
# DASHBOARD_GID=1000
