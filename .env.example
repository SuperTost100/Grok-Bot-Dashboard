# Your Tailscale login. Only this account can open the dashboard.
OWNER_LOGIN=you@example.com

# Shared secret the bots use. Generate one with: openssl rand -hex 24
BOT_TOKEN=

# Time zone for "today", the agenda and to-do dates.
TZ=Europe/Rome

# Optional: a Todoist API token (Settings > Integrations > Developer).
# Without it, to-dos come from your bots instead.
TODOIST_TOKEN=

# Optional: show only tasks matching a Todoist filter, like "today | overdue | p1".
# TODOIST_FILTER=

# Optional tweaks
# PORT=8787
# UNDO_SECONDS=5
# ARCHIVE_DAYS=30
