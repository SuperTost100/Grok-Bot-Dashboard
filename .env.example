# Your Tailscale login. Only this account can open the dashboard.
OWNER_LOGIN=you@example.com

# Shared secret the bots use. Generate one with: openssl rand -hex 24
BOT_TOKEN=

# Time zone for "today", the agenda and to-do dates.
TZ=Europe/Rome

# Mail, chats, calendars, Todoist and PoliTO are add-ons now: install them on the Add-ons page.

# Optional tweaks
# PORT=8787            host port, on 127.0.0.1 only
# UNDO_SECONDS=5       0 to 60
# ARCHIVE_DAYS=30      1 to 365
# BACKUP_DAYS=7        daily backups kept in data/backups, 0 turns them off
# WEBHOOK_ALLOW_PRIVATE=0   1 lets bots register webhooks on your LAN or tailnet

# Docker only: the user and group that own ./data (check with: id -u, id -g)
# DASHBOARD_UID=1000
# DASHBOARD_GID=1000
